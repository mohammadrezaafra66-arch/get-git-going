# مرجع کامل: docs/self-host-governance/10_ENVIRONMENT_MATRIX.md
# Lovable Cloud (Supabase) — auto-managed in Lovable, fill in for local dev
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- SH-RA.2B: external OCR feature flag (server-only) ---
# In dev / Lovable preview, OCR-on is the historical default. Self-host
# production sets EXTERNAL_OCR_ENABLED=false (see deploy/app/.env.production.example).
EXTERNAL_OCR_ENABLED=true
# Hard floor enforced in code is 15000ms; lower values are clamped up.
EXTERNAL_API_TIMEOUT_MS=15000

# --- MR-AUTO.1: Scheduled market-rate ingestion (server-only) ---
# In Lovable preview this is OFF by default. Enable per-environment.
MARKET_RATES_AUTO_INGEST_ENABLED=false
MARKET_RATES_EXTERNAL_ENABLED=false
NAVASAN_ENABLED=false
NAVASAN_API_KEY=
TGJU_ENABLED=false
# Long random string (>=32 chars). NEVER commit a real value.
MARKET_RATES_CRON_SECRET=
MARKET_RATES_INGEST_INTERVAL_MINUTES=15
