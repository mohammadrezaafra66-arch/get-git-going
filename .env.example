# AfraKala shared environment example
# This file is safe to commit.
# Do not put real secrets here.

APP_NAME=AfraKala
APP_ENV=local
APP_URL=http://localhost:3000

# Use staging or local-safe values only.
DATABASE_URL=postgresql://example_user:example_password@localhost:5432/afrakala_local

# Public client-side values may use VITE_ prefix.
VITE_APP_ENV=local
VITE_APP_URL=http://localhost:3000
VITE_SHOW_ENVIRONMENT_BANNER=true

# Never commit real service role keys, production tokens, or database passwords.
