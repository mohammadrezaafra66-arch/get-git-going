# AfraKala production environment example
# This file is safe to commit.
# Copy to .env.production on the server laptop and fill with real secrets locally.
# Do not commit the real .env.production file.

APP_NAME=AfraKala
APP_ENV=production
APP_URL=https://app.afrakala.local

# Must point to the production database only.
DATABASE_URL=postgresql://production_user:production_password@production-db-host:5432/afrakala_prod

VITE_APP_ENV=production
VITE_APP_URL=https://app.afrakala.local
VITE_SHOW_ENVIRONMENT_BANNER=false

# Optional Supabase placeholders
SUPABASE_URL=https://production-project.supabase.co
SUPABASE_ANON_KEY=replace_with_production_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_only_on_server_never_commit_real_value

# Production bot execution must remain disabled unless explicitly approved.
WORKER_MODE=controlled
ENABLE_REAL_BOT_EXECUTION=false
ENABLE_REAL_CUSTOMER_MESSAGING=false
