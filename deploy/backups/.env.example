# AfraKala — Backup env (نمونه)
# هرگز مقادیر واقعی را داخل ریپو commit نکنید.

# General
BACKUP_ROOT=/opt/afrakala/backups
RETENTION_DAYS_LOCAL=14
RETENTION_DAYS_OFFSITE=30

# Docker / Compose
SUPABASE_COMPOSE_FILE=/opt/afrakala/supabase/docker-compose.yml
SUPABASE_PROJECT_NAME=afrakala-supabase
POSTGRES_CONTAINER_NAME=db

# Postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Storage
SUPABASE_STORAGE_VOLUME_PATH=/opt/afrakala/supabase/volumes/storage

# Secrets backup (لیست با فاصله)
ENV_FILES_TO_BACKUP=/opt/afrakala/app/.env /opt/afrakala/supabase/.env /opt/afrakala/proxy/.env

# Encryption (age)
AGE_RECIPIENT=
AGE_IDENTITY_FILE=/root/.config/sops/age/keys.txt

# Offsite
OFFSITE_ENABLED=false
OFFSITE_REMOTE_NAME=
OFFSITE_REMOTE_PATH=

# Safety
DRY_RUN=true
CONFIRM_RESTORE=false