# AfraKala — Migration env (نمونه)
# این فایل را به deploy/migration/.env کپی و مقادیر واقعی را پر کنید.
# .env واقعی هرگز در ریپو commit نشود.

# Source — Lovable / Supabase Cloud
SOURCE_SUPABASE_URL=
SOURCE_SERVICE_ROLE_KEY=
SOURCE_DB_HOST=
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=postgres
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=

# Target — Supabase self-host افراکالا
TARGET_SUPABASE_URL=https://api.afrakala.ir
TARGET_SERVICE_ROLE_KEY=
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_NAME=postgres
TARGET_DB_USER=postgres
TARGET_DB_PASSWORD=

# Storage
STORAGE_BUCKET_PAYMENT_RECEIPTS=payment-receipt-documents
STORAGE_EXPORT_DIR=./storage-export

# Safety
DRY_RUN=true
CONFIRM_PRODUCTION=false