# AfraKala — Local Self-Host (laptop) — نمونه env
# این فایل را به deploy/local/.env.local کپی و مقادیر واقعی را پر کنید.
# .env.local هرگز commit نمی‌شود (در .gitignore).
#
# تولید مقادیر:
#   POSTGRES_PASSWORD : openssl rand -base64 32
#   JWT_SECRET        : openssl rand -base64 64   (≥32 char)
#   ANON_KEY / SERVICE_ROLE_KEY : با ابزار رسمی Supabase JWT generator
#     https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
#   VITE_SUPABASE_PUBLISHABLE_KEY : همان مقدار ANON_KEY

############
# Web (TanStack Start SSR)
############
NODE_ENV=production
PORT=3000

# build-time برای client bundle (فقط publishable/anon — هرگز service role)
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=afrakala-local

# runtime سرور (داخل docker network → kong)
SUPABASE_URL=http://kong:8000
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

############
# Postgres
############
POSTGRES_DB=postgres
POSTGRES_PASSWORD=

############
# JWT
############
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

############
# آدرس‌های local
############
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000,http://localhost:3001

############
# Auth — برای local تست راحت‌تر، signup باز و autoconfirm خاموش است
############
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

############
# SMTP (اختیاری — برای local خالی بگذارید)
############
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=افراکالا
SMTP_ADMIN_EMAIL=admin@local

############
# Studio dashboard (basic auth — فقط local)
############
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

############
# Feature flags
############
OCR_ENABLED=false
LOVABLE_API_KEY=