# AfraKala — LAN Pilot Env (نمونه)
# این فایل را به deploy/lan/.env.lan کپی کنید و مقادیر واقعی را بگذارید.
# هرگز .env.lan واقعی را commit نکنید.

# --- LAN host ---
# IP ثابت لپ‌تاپ روی شبکه شرکت. با scripts/show-ip.ps1 پیدا کنید.
LAN_HOST_IP=192.168.1.50
APP_PORT=3000
SUPABASE_API_PORT=8000

# --- Public client-safe vars (در زمان build داخل bundle جا می‌گیرند) ---
# کاربران LAN از مرورگر به این URL وصل می‌شوند، پس IP لپ‌تاپ.
VITE_SUPABASE_URL=http://192.168.1.50:8000
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=afrakala-lan
# مقدار public Supabase URL همان دستگاه (runtime)؛ هیچ secret نیست. خالی = unknown.
APP_SUPABASE_PUBLIC_URL=

# --- Server runtime (داخل docker network) ---
SUPABASE_URL=http://kong:8000
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres ---
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PORT=5432

# --- JWT / API keys (با ابزار رسمی Supabase تولید کنید) ---
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

# --- Auth URLs (باید IP لپ‌تاپ باشد تا redirectها در LAN کار کنند) ---
SITE_URL=http://192.168.1.50:3000
ADDITIONAL_REDIRECT_URLS=http://192.168.1.50:3000,http://localhost:3000
API_EXTERNAL_URL=http://192.168.1.50:8000
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

# --- SMTP (اختیاری در LAN — اگر خالی باشد ایمیل ارسال نمی‌شود) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=افراکالا
SMTP_ADMIN_EMAIL=

# --- Studio dashboard (اگر با profile studio روشن شود) ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme

# --- OCR در LAN pilot غیرفعال ---
OCR_ENABLED=false
LOVABLE_API_KEY=

# --- Ollama (self-hosted AI provider) ---
# OLLAMA_API_URL / OLLAMA_MODEL / OLLAMA_API_KEY are the names
# src/routes/api/messenger/ai-chat.ts already reads. Leave OLLAMA_API_URL
# empty to keep the local provider switched off.
OLLAMA_API_URL=http://192.168.170.8:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3:latest
OLLAMA_VISION_MODEL=qwen3.6:latest

# Capability probe, 2026-07-24 (see docs/execution-progress.md):
#   qwen2.5:7b    chat       — answers Persian in Persian, ~16s/short answer.
#                              Fluent, but hallucinates domain facts when
#                              ungrounded; only use it with retrieved context.
#   bge-m3        embedding  — 1024 dimensions (NOT 1536).
#   qwen3.6       vision     — reads Persian PROSE perfectly but MISREADS
#                              PERSIAN DIGITS reproducibly (۴→۲, ۳→۲). It read a
#                              45,000,000 amount as 25,000,000. DO NOT use it for
#                              receipt OCR — it is not safe on financial data.

# --- Runtime ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0