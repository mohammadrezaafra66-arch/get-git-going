# AfraKala — LAN Pilot Env (نمونه)
# این فایل را به deploy/lan/.env.lan کپی کنید و مقادیر واقعی را بگذارید.
# هرگز .env.lan واقعی را commit نکنید.

# --- LAN host ---
# IP ثابت لپ‌تاپ روی شبکه شرکت. با scripts/show-ip.ps1 پیدا کنید.
LAN_HOST_IP=192.168.1.50
APP_PORT=3000
SUPABASE_API_PORT=8000

# --- Public client-safe vars (در زمان build داخل bundle جا می‌گیرند) ---
# کاربران LAN از مرورگر به این URL وصل می‌شوند، پس IP لپ‌تاپ.
VITE_SUPABASE_URL=http://192.168.1.50:8000
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=afrakala-lan

# --- Server runtime (داخل docker network) ---
SUPABASE_URL=http://kong:8000
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres ---
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PORT=5432

# --- JWT / API keys (با ابزار رسمی Supabase تولید کنید) ---
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

# --- Auth URLs (باید IP لپ‌تاپ باشد تا redirectها در LAN کار کنند) ---
SITE_URL=http://192.168.1.50:3000
ADDITIONAL_REDIRECT_URLS=http://192.168.1.50:3000,http://localhost:3000
API_EXTERNAL_URL=http://192.168.1.50:8000
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

# --- SMTP (اختیاری در LAN — اگر خالی باشد ایمیل ارسال نمی‌شود) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=افراکالا
SMTP_ADMIN_EMAIL=

# --- Studio dashboard (اگر با profile studio روشن شود) ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme

# --- OCR در LAN pilot غیرفعال ---
OCR_ENABLED=false
LOVABLE_API_KEY=

# --- Runtime ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0