# مرجع کامل: docs/self-host-governance/10_ENVIRONMENT_MATRIX.md

# --- GHCR image (production pull-only; matches .github/workflows/build-image.yml) ---
# Workflow tags: ghcr.io/<owner>/<repo>-web:latest  و  :sha-<commit>
# اینها فقط روی سرور ست می‌شوند؛ مقدار واقعی هرگز در ریپو commit نشود.
GHCR_OWNER=
GHCR_REPO=
# IMAGE_TAG را برای rollback به یک sha مشخص ست کنید (مثلاً sha-<commit>).
# پیش‌فرض compose.prod اگر خالی باشد: latest
IMAGE_TAG=latest

# Public client-safe vars (baked into the client bundle at build time)
VITE_SUPABASE_URL=https://api.afrakala.ir
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=afrakala-self

# Server-only runtime vars (NEVER prefix with VITE_)
SUPABASE_URL=http://kong:8000
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional until OCR replacement phase
LOVABLE_API_KEY=
OCR_ENABLED=false

# --- SH-RA.2B: external OCR feature flag (server-only, NEVER prefix VITE_) ---
# Strict self-host default: external Lovable AI gateway is OFF.
# Operators may flip to true *only* if they accept an external dependency.
EXTERNAL_OCR_ENABLED=false
# Floor of 15000ms is enforced in code; values below are clamped up.
EXTERNAL_API_TIMEOUT_MS=15000

# --- Market rates external ingestion (FX.2) ---
# همه پیش‌فرض false. اگر هیچ‌کدام فعال نباشد ثبت دستی نرخ همچنان کار می‌کند.
# هرگز این متغیرها را با پیشوند VITE_ تعریف نکنید — server-only هستند.
MARKET_RATES_EXTERNAL_ENABLED=false

NAVASAN_ENABLED=false
NAVASAN_API_KEY=
NAVASAN_BASE_URL=https://www.navasan.tech/api

TGJU_ENABLED=false
TGJU_API_KEY=
TGJU_BASE_URL=

# MR-AUTO.2 — Navasan twice-daily schedule (Sat–Wed 12:00 & 13:00 Asia/Tehran).
# برای فعال‌سازی برنامه‌ریزی خودکار، این پرچم را true کنید و اسکریپت
# deploy/migration/scripts/mr-auto-2-schedule-navasan-twice-daily.sql را
# روی Postgres اعمال کنید. ثبت دستی نرخ در هر حالت فعال می‌ماند.
# UTC cron معادل: 30 8,9 * * 6,0-3

# --- MR-AUTO.1: Scheduled market-rate ingestion (cron) ---
# Endpoint: POST /api/public/hooks/ingest-market-rates
# Header: Authorization: Bearer ${MARKET_RATES_CRON_SECRET}
# Self-host scheduler: pg_cron every MARKET_RATES_INGEST_INTERVAL_MINUTES.
# Master switch for the scheduled job (server-only). Default: false.
MARKET_RATES_AUTO_INGEST_ENABLED=false
# Long random string (>=32 chars). NEVER commit a real value. server-only.
MARKET_RATES_CRON_SECRET=
# Schedule frequency in minutes (used by pg_cron migration).
MARKET_RATES_INGEST_INTERVAL_MINUTES=15

# --- PRICE-RT.5: Pricing recompute worker (cron) ---
# Endpoint: POST /api/public/hooks/process-pricing-queue
# Header:   Authorization: Bearer ${PRICING_WORKER_TOKEN}
# Self-host scheduler: host cron / systemd timer (preferred) — see
#   docs/PRICING_RECOMPUTE_WORKER.md and docs/self-host-governance/08_OPS_RUNBOOK.md.
# Long random string (>=32 chars). NEVER commit a real value. server-only.
# NEVER prefix with VITE_ — must not appear in the client bundle.
PRICING_WORKER_TOKEN=

# --- Phase 10 / requirement 224: recurring marketing task generator (cron) ---
# Endpoint: POST /api/public/hooks/generate-marketing-tasks
# Header:   Authorization: Bearer ${MARKETING_TASKS_WORKER_TOKEN}
# Self-host scheduler: host cron — see
#   deploy/app/scripts/marketing-tasks-cron.example.sh
# Fire just after the Tehran day starts (00:05 Tehran = 20:35 UTC previous day).
# The job itself resolves "today" via public.tehran_today(), so a late or
# repeated run is safe: it is idempotent and takes a per-day advisory lock.
# Long random string (>=32 chars). NEVER commit a real value. server-only.
# NEVER prefix with VITE_ — must not appear in the client bundle.
MARKETING_TASKS_WORKER_TOKEN=

# App runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000