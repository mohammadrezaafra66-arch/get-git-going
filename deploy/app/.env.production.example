# مرجع کامل: docs/self-host-governance/10_ENVIRONMENT_MATRIX.md

# --- GHCR image (production pull-only; matches .github/workflows/build-image.yml) ---
# Workflow tags: ghcr.io/<owner>/<repo>-web:latest  و  :sha-<commit>
# اینها فقط روی سرور ست می‌شوند؛ مقدار واقعی هرگز در ریپو commit نشود.
GHCR_OWNER=
GHCR_REPO=
# IMAGE_TAG را برای rollback به یک sha مشخص ست کنید (مثلاً sha-<commit>).
# پیش‌فرض compose.prod اگر خالی باشد: latest
IMAGE_TAG=latest

# Public client-safe vars (baked into the client bundle at build time)
VITE_SUPABASE_URL=https://api.afrakala.ir
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=afrakala-self

# Server-only runtime vars (NEVER prefix with VITE_)
SUPABASE_URL=http://kong:8000
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional until OCR replacement phase
LOVABLE_API_KEY=
OCR_ENABLED=false

# --- SH-RA.2B: external OCR feature flag (server-only, NEVER prefix VITE_) ---
# Strict self-host default: external Lovable AI gateway is OFF.
# Operators may flip to true *only* if they accept an external dependency.
EXTERNAL_OCR_ENABLED=false
# Floor of 15000ms is enforced in code; values below are clamped up.
EXTERNAL_API_TIMEOUT_MS=15000

# --- Market rates external ingestion (FX.2) ---
# همه پیش‌فرض false. اگر هیچ‌کدام فعال نباشد ثبت دستی نرخ همچنان کار می‌کند.
# هرگز این متغیرها را با پیشوند VITE_ تعریف نکنید — server-only هستند.
MARKET_RATES_EXTERNAL_ENABLED=false

NAVASAN_ENABLED=false
NAVASAN_API_KEY=
NAVASAN_BASE_URL=https://www.navasan.tech/api

TGJU_ENABLED=false
TGJU_API_KEY=
TGJU_BASE_URL=

# App runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000