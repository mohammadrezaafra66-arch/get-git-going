# Public client-safe vars (baked into the client bundle at build time)
VITE_SUPABASE_URL=https://api.afrakala.ir
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=afrakala-self

# Server-only runtime vars (NEVER prefix with VITE_)
SUPABASE_URL=http://kong:8000
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional until OCR replacement phase
LOVABLE_API_KEY=
OCR_ENABLED=false

# --- Market rates external ingestion (FX.2) ---
# همه پیش‌فرض false. اگر هیچ‌کدام فعال نباشد ثبت دستی نرخ همچنان کار می‌کند.
# هرگز این متغیرها را با پیشوند VITE_ تعریف نکنید — server-only هستند.
MARKET_RATES_EXTERNAL_ENABLED=false

NAVASAN_ENABLED=false
NAVASAN_API_KEY=
NAVASAN_BASE_URL=https://www.navasan.tech/api

TGJU_ENABLED=false
TGJU_API_KEY=
TGJU_BASE_URL=

# App runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000