# AfraKala — Supabase self-host (نمونه)
# این فایل را به deploy/supabase/.env کپی و مقادیر واقعی را تولید کنید.
# هرگز مقادیر واقعی را commit نکنید (در .gitignore است).

############
# Postgres
############
POSTGRES_DB=postgres
POSTGRES_PASSWORD=replace-with-strong-password

############
# JWT — حتماً با `openssl rand -base64 64` تولید کنید
############
JWT_SECRET=replace-with-64-char-random-secret
JWT_EXPIRY=3600

# کلیدهای ANON و SERVICE_ROLE با ابزار رسمی Supabase JWT ساخته می‌شوند
# https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
ANON_KEY=replace-with-generated-anon-jwt
SERVICE_ROLE_KEY=replace-with-generated-service-role-jwt

############
# آدرس‌های عمومی (پشت Caddy)
############
SITE_URL=https://app.afrakala.ir
API_EXTERNAL_URL=https://api.afrakala.ir
ADDITIONAL_REDIRECT_URLS=https://app.afrakala.ir

############
# Auth
############
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

############
# SMTP (اختیاری — اگر mailer داخلی استفاده می‌شود)
############
SMTP_ADMIN_EMAIL=admin@afrakala.ir
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=AfraKala

############
# Studio dashboard credentials (basic auth Kong)
############
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-strong-password