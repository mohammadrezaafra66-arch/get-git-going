# AfraKala staging environment example
# This file is safe to commit.
# Copy to .env.staging on the staging/test computer and fill with local secrets.
# Do not commit the real .env.staging file.

APP_NAME=AfraKala
APP_ENV=staging
APP_URL=http://localhost:3000

# Must point to the staging/test database only.
DATABASE_URL=postgresql://staging_user:staging_password@localhost:5432/afrakala_staging

VITE_APP_ENV=staging
VITE_APP_URL=http://localhost:3000
VITE_SHOW_ENVIRONMENT_BANNER=true
VITE_ENVIRONMENT_BANNER_TEXT=TEST ENVIRONMENT - DATA IS NOT REAL

# Optional Supabase placeholders
SUPABASE_URL=https://staging-project.supabase.co
SUPABASE_ANON_KEY=replace_with_staging_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_only_on_machine_never_commit_real_value

# Worker execution must be safe in staging.
WORKER_MODE=mock
ENABLE_REAL_BOT_EXECUTION=false
ENABLE_REAL_CUSTOMER_MESSAGING=false
