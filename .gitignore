# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor and agent-tool directories
.vscode/*
!.vscode/extensions.json
# Claude Code's per-machine settings and local session state. .cursor/ and
# .lovable/ are deliberately NOT ignored — both are tracked and shared.
.claude/
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables
.env
.env.local
.env.*.local
# AfraKala self-host runtime files (never commit real secrets)
deploy/app/.env.production
deploy/app/.env
deploy/proxy/.env
deploy/proxy/Caddyfile
deploy/proxy/certs/
deploy/supabase/.env
deploy/supabase/volumes/*
!deploy/supabase/volumes/db/
deploy/supabase/volumes/db/*
!deploy/supabase/volumes/db/init/
!deploy/supabase/volumes/db/init/*.sql

# TLS / certificate secrets
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx

# Allow example templates
!deploy/app/.env.production.example
!deploy/proxy/.env.example
!deploy/proxy/Caddyfile.example
!deploy/supabase/.env.example
!deploy/supabase/kong.yml.example

# AfraKala migration runtime outputs
deploy/migration/.env
deploy/migration/dumps/
deploy/migration/storage-export/
deploy/migration/**/*.dump
deploy/migration/**/storage-manifest*.json

# AfraKala backup runtime outputs
deploy/backups/.env
deploy/backups/pg/
deploy/backups/storage/
deploy/backups/storage-safety/
deploy/backups/env/
deploy/backups/**/*.dump
deploy/backups/**/*.tar
deploy/backups/**/*.tar.gz
deploy/backups/**/*.age
# AfraKala LAN pilot runtime (never commit real secrets)
deploy/lan/.env
deploy/lan/.env.lan
deploy/lan/data/
deploy/lan/volumes/
deploy/lan/storage-export/
deploy/lan/**/*.dump
deploy/lan/**/*.pem
deploy/lan/**/*.key
deploy/lan/**/*.crt
!deploy/lan/.env.lan.example
#

e2e/auth/*.storage.json
# Local-only interactive helpers (must never be committed with secrets/output)
e2e/auth/local-only/

# Playwright runtime evidence (screenshots, videos, traces, reports)
test-results/
playwright-report/
traces/
screenshots/

# Database dumps and backup output — rule 4: never commit backups or dumps.
# Root-anchored on purpose. A bare `backups/` would also match deploy/backups/,
# whose scripts/ and README.md ARE tracked; new files added there would then be
# silently invisible to git status.
/backups/
*.dump
*.sql.gz

# Ad-hoc data exports downloaded into the repo (rule 4: no data dumps in git).
# Owner instruction 2026-08-07: "my repo should contain zero xlsx files ever."
# Supersedes the earlier carve-out that deliberately tracked the Asan layout
# samples under docs/verification/.
*.xlsx

# Phase cleanup backups (rule 4). P0_CLEANUP.md phase 0.3 tells the agent to write
# a pg_dump into docs/verification/, but that dump carries live business rows -
# it is a restore artefact, not documentation. Kept on disk, never committed.
# P0.5 exists precisely because a data export reached git history once already.
docs/verification/P0.*-*-backup.sql
