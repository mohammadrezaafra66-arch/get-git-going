# Optional local-only Playwright credentials.
# Copy to .env.e2e.local when you want to provide fixed LAN test passwords.
# .env.e2e.local is ignored by git via .env.*.local.

E2E_ACCOUNTANT_EMAIL=test.accountant@afrakala.local
E2E_ACCOUNTANT_PASSWORD=

E2E_SALESPERSON_A_EMAIL=test.sales@afrakala.local
E2E_SALESPERSON_A_PASSWORD=

E2E_SALESPERSON_B_EMAIL=test.sales2@afrakala.local
E2E_SALESPERSON_B_PASSWORD=

# Optional shared password for all three LAN users.
E2E_LAN_TEST_PASSWORD=

# Set to 0 to forbid the generator from setting an ephemeral LAN-only password
# through Supabase Auth Admin API when no password is provided above.
E2E_ALLOW_LAN_PASSWORD_RESET=1
