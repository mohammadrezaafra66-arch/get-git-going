{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afrakala.ir/schemas/automation/heartbeat.schema.json",
  "title": "WorkerHeartbeat",
  "description": "Worker liveness and capacity report. Phase 0 contract only — no runtime enforcement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "worker_id",
    "reported_at",
    "status",
    "capabilities"
  ],
  "properties": {
    "worker_id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable worker instance identifier assigned at registration."
    },
    "reported_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp from the worker clock (control plane may reconcile skew)."
    },
    "status": {
      "type": "string",
      "enum": ["healthy", "degraded", "draining", "offline"],
      "description": "Current operational status."
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{1,63}$",
        "description": "Generic capability tag. Phase 0 allows only documented generic tags; no marketplace-specific integrations."
      },
      "examples": [["generic.echo", "generic.noop"]]
    },
    "active_jobs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    },
    "max_concurrent_jobs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 1
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "description": "Worker software version string for observability."
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostname": {
          "type": "string",
          "maxLength": 255
        },
        "platform": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Opaque key-value metadata. Must not contain secrets.",
      "additionalProperties": {
        "type": "string",
        "maxLength": 512
      }
    }
  }
}
